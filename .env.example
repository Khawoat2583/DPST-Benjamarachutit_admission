# Runtime user connection (SELECT, INSERT, UPDATE only, no schema modification or DDL)
DATABASE_URL=postgres://dpst_app_user:change_me@127.0.0.1:5432/dpst_admission

# Migration user connection (Full schema DDL / owner permissions to create/alter tables)
MIGRATION_DATABASE_URL=postgres://dpst_migration_user:change_me_super@127.0.0.1:5432/dpst_admission

UPLOAD_ROOT=/var/lib/dpst-admission/uploads
SESSION_SECRET=change_me_to_a_random_32_byte_secret
NEXT_PUBLIC_APP_NAME=DPST Admission
RESEND_API_KEY="re_your_api_key_here"

